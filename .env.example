# PostgreSQL (matches docker-compose defaults unless overridden)
DB_USERNAME=playground
DB_PASSWORD=playground
DB_HOSTNAME=localhost
# Host port (maps to container 5432). Default 5439 avoids conflicting with a Mac/Homebrew Postgres on 5432.
DB_PORT=5439
DB_DATABASE=playground

# If you change DB_USERNAME/DB_DATABASE, update docker-compose healthcheck and POSTGRES_* accordingly.

# Redis (docker-compose service `redis`; used by ai_analyze_service_mutithread)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Or a single URL: REDIS_URL=redis://127.0.0.1:6379/0

# Instagram scraper — keep `.env` as simple KEY=value lines only (Docker Compose reads `.env` and
# rejects multi-line values). Put the Firefox cookie export JSON in a separate file:
#   INSTAGRAM_COOKIE_FILE=instagram_cookies_firefox.json
# INSTAGRAM_PROFILE_USERNAME=your_handle

# FOMO cloud ingest (HTTPS JSON sync from POST /sync/fomo). Rows are read from the DB in batches
# (keyset by id) so large tables (e.g. 10k+ rows) do not load entirely into memory.
# FOMO OpenAPI: POST /sync/instagram-posts. Host-only URL gets that path appended automatically.
# FOMO_SYNC_URL=http://localhost:8002/sync/instagram-posts
FOMO_SYNC_URL=http://localhost:8002
FOMO_SYNC_API_KEY=test_share_secret_1824
# How to send the shared secret: bearer (default) | x_api_key | authorization_raw
# FOMO_SYNC_AUTH_MODE=bearer
# Rows per HTTP request (smaller = smaller JSON bodies; more requests).
FOMO_SYNC_BATCH_SIZE=250
# Per-request timeout in seconds (large batches / slow links may need more).
FOMO_SYNC_TIMEOUT_SECONDS=300
