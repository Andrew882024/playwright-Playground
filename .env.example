# PostgreSQL (matches docker-compose defaults unless overridden)
DB_USERNAME=playground
DB_PASSWORD=playground
DB_HOSTNAME=localhost
# Host port (maps to container 5432). Default 5439 avoids conflicting with a Mac/Homebrew Postgres on 5432.
# DB_PORT=5439
DB_PORT=5439
DB_DATABASE=playground

# If you change DB_USERNAME/DB_DATABASE, update docker-compose healthcheck and POSTGRES_* accordingly.

# Redis (docker-compose service `redis`; used by ai_analyze_service_mutithread)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Or a single URL: REDIS_URL=redis://127.0.0.1:6379/0

# Instagram scraper — keep `.env` as simple KEY=value lines only (Docker Compose reads `.env` and
# rejects multi-line values). Put the Firefox cookie export JSON in a separate file:
#   INSTAGRAM_COOKIE_FILE=instagram_cookies_firefox.json
# INSTAGRAM_PROFILE_USERNAME=your_handle

# Incoming API authentication (server-side only; never commit actual credentials).
# Supply two independently generated random tokens in ignored .env or deployment secrets.
# Each must be 32..512 characters, have no surrounding whitespace, and be different.
# Send the appropriate token as Authorization: Bearer <token>.
# Read token: GET recovery/status endpoints only; it does not authorize sync actions.
PLAYGROUND_RECOVERY_READ_TOKEN=
# Sync token: POST /sync/fomo and POST /sync/instagram_pipeline; may trigger writes/API costs.
PLAYGROUND_SYNC_TOKEN=
# Blank/invalid credentials fail closed with HTTP 503; wrong caller credentials return 401.
# These incoming service tokens are separate from outbound FOMO_SYNC_API_KEY.

# FOMO cloud ingest (HTTPS JSON sync from POST /sync/fomo). Rows are read from the DB in batches
# (keyset by id) so large tables (e.g. 10k+ rows) do not load entirely into memory.
# FOMO OpenAPI: POST /sync/instagram-posts. Host-only URL gets that path appended automatically.
# FOMO_SYNC_URL=http://localhost:8002/sync/instagram-posts
FOMO_SYNC_URL=http://localhost:8002
# Outbound FOMO credential: set only in ignored .env or deployment secrets.
FOMO_SYNC_API_KEY=
# How to send the shared secret: bearer (default) | x_api_key | authorization_raw
# FOMO_SYNC_AUTH_MODE=bearer
# Rows per HTTP request (smaller = smaller JSON bodies; more requests).
FOMO_SYNC_BATCH_SIZE=250
# Per-request timeout in seconds (large batches / slow links may need more).
FOMO_SYNC_TIMEOUT_SECONDS=300

# Optional generated covers (server-side only; never NEXT_PUBLIC_*).
# Set the real key in ignored .env or deployment secrets; never commit it.
OPENAI_API_KEY=
AI_COVER_IMAGE_MODEL=gpt-image-2
# Must survive restarts/container replacement: mount a persistent volume in production.
# Default is <repository>/event_cover_cache. Keep source/PNG/manifests for recovery.
# EVENT_COVER_CACHE_DIR=/persistent/path/event-covers
# Uses existing AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION and S3_BUCKET.
# After manual migration: inspect with --dry-run; --generate authorizes at most ONE call.
# Ambiguous/time-out requests are never automatically retried, even after restart.

# Optional POST /sync/instagram_pipeline parent-cover stage (disabled by default).
# Runs AFTER original-image S3 backfill, only for parents committed by this run.
INSTAGRAM_PIPELINE_GENERATE_COVERS=false
# Maximum cover attempts, including failures/recovery; 0 disables attempts. Default: 1.
INSTAGRAM_PIPELINE_COVER_MAX_ATTEMPTS=1
# Individual cover failures are reported separately and do not fail extraction.

# Optional GLOBAL Gemini post-attempt cap for POST /sync/instagram_pipeline only.
# Blank/unset preserves unlimited analysis. Set to 1 for the first full-scrape test.
# Includes failed posts across ALL profiles; retries within one post use one slot.
# Does not limit scraping or change the serial CLI's per-profile --limit.
# Invalid/negative values reject the pipeline request before scraping; 0 skips Gemini analysis.
INSTAGRAM_PIPELINE_GEMINI_MAX_ATTEMPTS=

# Optional Event Master import AFTER the cover stage; disabled by default.
# Uses ONLY parents committed in the current Gemini run, even if covers fail.
INSTAGRAM_PIPELINE_SYNC_EVENT_MASTER=false
# Set absolute paths to your separate Event Master checkout and its interpreter before enabling.
EVENT_MASTER_BACKEND_DIR=
EVENT_MASTER_IMPORT_PYTHON=
EVENT_MASTER_IMPORT_TIMEOUT_SECONDS=60
# Backend must have its OWN .env: MySQL DB_* and INSTAGRAM_DB_PASSWORD (noninteractive).
# Playground DB_*, Python import paths, API/AWS keys are NOT forwarded to the subprocess.
# Parent importer is local-only, uses provider user 1 and stable parent markers.
# Sync-only recovery (explicitly authorizes imports even while automatic sync is disabled):
#   python sync_instagram_posts_to_event_master.py --post-id <parent-id> --sync
# Omit --sync (or use --dry-run) for an ID-only inspection with no importer/database calls.

# Active Instagram post age in days; historical database rows are retained.
INSTAGRAM_SCRAPE_MAX_AGE_DAYS=40

# Shared durable request budgets for discovery + standalone parent runners.
# LA calendar days; failures/uncertain requests consume reservations. 0 disables new requests.
INSTAGRAM_DAILY_GEMINI_MAX_REQUESTS=20
INSTAGRAM_DAILY_COVER_MAX_REQUESTS=3
# Default: ~/.local/state/event-master/instagram-paid-requests (outside repository cleanup).
# All processes must use the SAME absolute persistent directory and OS user.
# Never delete/reset/rotate this directory or restore stale usage while jobs can run.
# See DAILY_PAID_REQUEST_BUDGET.md for backup, retention, and scope.
# INSTAGRAM_PAID_REQUEST_LEDGER_DIR=/absolute/persistent/path/instagram-paid-requests

# Durable discovery CLI execution records (separate from paid journals/budgets).
# Default: ~/.local/state/event-master/instagram-discovery-runs
# Keep on persistent local storage; see DISCOVERY_EXECUTION_LOGGING.md.
# INSTAGRAM_DISCOVERY_LOG_DIR=/absolute/persistent/path/instagram-discovery-runs

# Optional parent recovery (requires explicit recovery-table migration). Never auto-adopts legacy cards.
INSTAGRAM_PIPELINE_RECOVER_COVERS=false
INSTAGRAM_PIPELINE_COVER_RECOVERY_MAX_ATTEMPTS=1
INSTAGRAM_PIPELINE_RECOVER_EVENT_MASTER=false
INSTAGRAM_PIPELINE_EVENT_MASTER_RECOVERY_MAX_ATTEMPTS=1
# Failed attempts per revision before review; cooldown starts at 15 minutes, caps at 24 hours.
INSTAGRAM_PIPELINE_RECOVERY_MAX_FAILURES=5
# Cover recovery shares the normal COVER_MAX_ATTEMPTS generation allowance; saved PNGs can resume without it.
# Recovery preview: python preview_instagram_pipeline_recovery.py (SELECT-only; no importer/API/storage calls).
