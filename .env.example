# PostgreSQL (matches docker-compose defaults unless overridden)
DB_USERNAME=playground
DB_PASSWORD=playground
DB_HOSTNAME=localhost
# Host port (maps to container 5432). Default 5439 avoids conflicting with a Mac/Homebrew Postgres on 5432.
DB_PORT=5439
DB_DATABASE=playground

# If you change DB_USERNAME/DB_DATABASE, update docker-compose healthcheck and POSTGRES_* accordingly.

# Instagram scraper — keep `.env` as simple KEY=value lines only (Docker Compose reads `.env` and
# rejects multi-line values). Put the Firefox cookie export JSON in a separate file:
#   INSTAGRAM_COOKIE_FILE=instagram_cookies_firefox.json
# INSTAGRAM_PROFILE_USERNAME=your_handle
